# =============================================================================
# apps/.env.example
# =============================================================================
#
# Template for the environment variables consumed by Plans 2 (apps/api/) and
# 3 (apps/web/). Copy real values into a gitignored .env file (e.g.
# `apps/api/.env` or `apps/web/.env.local`) — DO NOT commit secrets here.
#
# For local development, the repo root holds `.env.local` with the same keys
# (see /Users/erik/Developer/Github/Snapsonic/tradingAgents/.env.local).
# Plans 2 and 3 will read from per-app .env files in production.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (used by both apps)
# -----------------------------------------------------------------------------
# Public URL of the cloud project. Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co

# Anonymous (public) key — safe to expose to browsers.
# Used by apps/web (Next.js client + SSR).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — SECRET. Used by apps/api (FastAPI on Render) only.
# This key bypasses RLS — never expose to browsers.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# JWT secret used by apps/api to verify Supabase-signed user JWTs against
# Supabase's JWKS. Found at: Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=

# Project ref (the <ref> portion of <ref>.supabase.co). Used by deploy
# scripts and the supabase CLI.
SUPABASE_PROJECT_REF=
